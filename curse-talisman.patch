+  eventTimes: [120, 300, 480] as readonly number[],
+  caps: { enemyMoveSpeedMultiplier: 1.6, attackSpeedMultiplier: 2, enemyMaxCountMultiplier: 2 },
+  // Absolute pooled-entity ceiling, including elites and the two boss objects.
